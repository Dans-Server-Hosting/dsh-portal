# Base URL of dsh-api, read on the server only (never sent to the browser).
DSH_API_URL=http://127.0.0.1:4000
# Base URL of UserAuth's REST API (POST /login, /register, /logout, change password). Server-side only.
USERAUTH_URL=http://127.0.0.1:4000/userauth
# Path of UserAuth's change-password endpoint under USERAUTH_URL. Defaults to /password;
# the mock reads the same variable, so the two always agree.
# USERAUTH_CHANGE_PASSWORD_PATH=/password
# The portal's own public origin, used for redirects after sign-out
# (defaults to the request origin).
PORTAL_URL=http://localhost:3000
# Set to 0 to allow the session cookie over plain http (local development only).
# Defaults to 1 whenever NODE_ENV=production.
DSH_SECURE_COOKIE=1
